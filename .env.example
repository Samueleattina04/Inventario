APP_NAME="Inventario"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ─── MySQL principale (app) ───────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=inventario
DB_USERNAME=root
DB_PASSWORD=

# ─── SQL Server (DB articoli primario) ───────────────────────────────────────
SQLSRV_HOST=192.168.1.10
SQLSRV_PORT=1433
SQLSRV_DATABASE=GestionaleProd
SQLSRV_USERNAME=sa
SQLSRV_PASSWORD=

# Nome tabella articoli e mappatura colonne nel DB SQL Server
SQLSRV_TABLE_ARTICLES=Articoli
SQLSRV_COL_CODE=CodArt
SQLSRV_COL_DESC=Descrizione
SQLSRV_COL_UM=UnitaMisura
SQLSRV_COL_LOT=Lotto

# ─── Access (DB articoli secondario, via ODBC) ────────────────────────────────
ACCESS_DSN=Driver={Microsoft Access Driver (*.mdb, *.accdb)};Dbq=\\\\server\\share\\inventario.accdb;
ACCESS_USERNAME=
ACCESS_PASSWORD=

# Nome tabella articoli e mappatura colonne nel DB Access
ACCESS_TABLE_ARTICLES=TAB_ARTICOLI
ACCESS_COL_CODE=CODICE
ACCESS_COL_DESC=DESCRIZIONE
ACCESS_COL_UM=UM
ACCESS_COL_LOT=LOTTO

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="inventario@azienda.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
